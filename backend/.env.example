# Field of Soma - Backend Environment Configuration

# 1. MongoDB Database Connection
# Local MongoDB: mongodb://127.0.0.1:27017/field_of_soma
# MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/field_of_soma?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/field_of_soma
MONGODB_DB_NAME=field_of_soma

# 2. SMTP Outgoing Mail (Hostinger / Gmail / Zoho)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@fieldofsoma.com
SMTP_PASS=your_email_password
NOTIFY_EMAIL=info@fieldofsoma.com
FROM_NAME="Field of Soma"

# 3. Server Port
PORT=3001
HOST=0.0.0.0
